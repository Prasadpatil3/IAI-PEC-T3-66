    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nif (rows.length === 0) {\n  return [{\n    json: {\n      text: \"You have no saved tasks yet. Use /task to add one.\"\n    }\n  }];\n}\n\nconst lines = rows.map((row, index) => {\n  return `${index + 1}. ${row.task}\\nDeadline: ${row.deadline}\\nStatus: ${row.status}`;\n});\n\nreturn [{\n  json: {\n    text: \"📚 Your Study Tasks\\n\\n\" + lines.join(\"\\n\\n\")\n  }\n}];"
      },
