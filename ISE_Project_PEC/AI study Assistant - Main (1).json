    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\nconst message = $('Telegram Trigger').first().json.message;\nconst text = (message.text || '').trim();\n\nconst match = text.match(/^\\/complete(?:@\\w+)?\\s+(\\d+)$/i);\n\nif (!match) {\n  return [{\n    json: {\n      chat_id: message.chat.id,\n      error: 'Use /complete 1 to complete task 1.'\n    }\n  }];\n}\n\nconst taskNumber = Number(match[1]);\n\n// Ignore rows without a task name.\nconst tasks = rows.filter(row =>\n  String(row.chat_id) === String(message.chat.id) &&\n  String(row.task || '').trim() !== ''\n);\n\nif (taskNumber < 1 || taskNumber > tasks.length) {\n  return [{\n    json: {\n      chat_id: message.chat.id,\n      error: `Task ${taskNumber} was not found. You have ${tasks.length} saved task(s).`\n    }\n  }];\n}\n\nconst task = tasks[taskNumber - 1];\n\nreturn [{\n  json: {\n    chat_id: message.chat.id,\n    task: task.task,\n    deadline: task.deadline,\n    status: 'completed',\n    reminder_sent: task.reminder_sent,\n    task_number: taskNumber,\n    row_number: task['row number'] ?? task.row_number ?? task.rowNumber ?? null,\n    message: `Task completed: ${task.task}`\n  }\n}];\n"
      },
