    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=\n{{\n  '📚 ' + $json.topic + '\\n\\n' +\n  JSON.parse($json.questions_json).map((q, i) =>\n    (i + 1) + '. ' + q.question + '\\n' +\n    'A) ' + q.options.A + '\\n' +\n    'B) ' + q.options.B + '\\n' +\n    'C) ' + q.options.C + '\\n' +\n    'D) ' + q.options.D\n  ).join('\\n\\n') +\n  '\\n\\n✍️ Reply with your answers!'\n}}\n",
        "additionalFields": {
