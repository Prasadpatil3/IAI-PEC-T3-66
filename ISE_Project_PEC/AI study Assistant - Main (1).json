    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\n// Get the quiz output from Basic LLM Chain\nlet rawQuiz = input.text || input.response || input.output || input;\n\n// Parse JSON if the AI returned a string\nlet quiz;\n\nif (typeof rawQuiz === 'string') {\n  // Remove optional Markdown code fences\n  rawQuiz = rawQuiz\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  quiz = JSON.parse(rawQuiz);\n} else {\n  quiz = rawQuiz;\n}\n\n// Extract questions\nconst questions = quiz.questions || [];\n\nif (!Array.isArray(questions) || questions.length === 0) {\n  throw new Error(\n    'No quiz questions found. Check the Basic LLM Chain output.'\n  );\n}\n\n// Format the quiz for Telegram\nconst formattedQuiz = [\n  `📚 ${quiz.topic || 'Practice Quiz'}`,\n  '',\n  'Answer each question by choosing A, B, C, or D.',\n  '',\n  ...questions.flatMap((q, index) => [\n    `${index + 1}. ${q.question}`,\n    `A) ${q.options?.A || ''}`,\n    `B) ${q.options?.B || ''}`,\n    `C) ${q.options?.C || ''}`,\n    `D) ${q.options?.D || ''}`,\n    ''\n  ]),\n  '✍️ Reply with your answers, for example: 1-A, 2-C, 3-B'\n].join('\\n');\n\n// Get the chat ID from the Telegram Trigger\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      topic: quiz.topic || 'Practice Quiz',\n      questions_json: JSON.stringify(questions),\n      formatted_quiz: formattedQuiz,\n      current_question: 0,\n      score: 0,\n      status: 'active'\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        608
      ],
