    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\n// Find the latest active quiz session.\nconst sessions = rows\n  .filter(row => row.status === 'active' && row.questions_json)\n  .sort((a, b) => Number(b.row_number || b.rowNumber || 0) -\n                  Number(a.row_number || a.rowNumber || 0));\n\nif (sessions.length === 0) {\n  throw new Error('No active quiz session with questions_json was found.');\n}\n\nconst session = sessions[0];\nconst questions = typeof session.questions_json === 'string'\n  ? JSON.parse(session.questions_json)\n  : session.questions_json;\n\n// Get the incoming Telegram answer message.\nconst answerText = $('Telegram Trigger').first().json.message.text || '';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\n// Accept answers like: 1-A, 2-C, 3-B, 4-D, 5-A\nconst answerMap = {};\nconst pattern = /(\\d+)\\s*[-:.)]\\s*([A-D])/gi;\nlet match;\n\nwhile ((match = pattern.exec(answerText)) !== null) {\n  answerMap[Number(match[1])] = match[2].toUpperCase();\n}\n\nif (Object.keys(answerMap).length === 0) {\n  throw new Error('No answers found. Use a format like 1-A, 2-C, 3-B.');\n}\n\nlet score = 0;\nconst feedback = [];\n\nquestions.forEach((q, index) => {\n  const questionNumber = index + 1;\n  const userAnswer = answerMap[questionNumber] || 'Not answered';\n  const correctAnswer = String(q.correct_answer || '').trim().toUpperCase();\n  const isCorrect = userAnswer === correctAnswer;\n\n  if (isCorrect) score++;\n\n  feedback.push(\n    `${questionNumber}. ${isCorrect ? '✅' : '❌'} Your answer: ${userAnswer} | Correct: ${correctAnswer}` +\n    (q.explanation ? `\\n   ${q.explanation}` : '')\n  );\n});\n\nconst total = questions.length;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    topic: session.topic || 'Quiz',\n    score,\n    total,\n    status: 'completed',\n    feedback: feedback.join('\\n\\n'),\n    result_message:\n      `📊 Quiz Results: ${session.topic || 'Quiz'}\\n\\n` +\n      `Score: ${score}/${total}\\n\\n` +\n      feedback.join('\\n\\n')\n  }\n}];\n"
      },
